//   });


// Print band names in the console window
print(image.bandNames());


// -------- //
// METHOD 3 //
// -------- //


// Another way to define the NDVI formula.
// number of the band: n(4)
// var NDVI = image.expression('(b(4)-b(3))/(b(4)+b(3))');


// -------- //
// METHOD 4 //
// -------- //


// name of the band: n(4)
var NDVI = image.expression('(b(\'B5\')-b(\'B4\'))/(b(\'B5\')+b(\'B4\'))');


// -------------------------------


// Adding the NDVI layer to the map.
Map.addLayer(NDVI,imageVisParam,'NDVI');


// Centering the map on the NDVI location.
Map.centerObject(NDVI,10);
