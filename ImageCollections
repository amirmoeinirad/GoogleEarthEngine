// The final median image
// 'median()' computes the median of all pixel vectors across a collection
// 'clip()' clips an image using a geometry (polygon).
var L8_Collection_Median = Filtered_Region_Cloud_Date.median().clip(Gilan);
Map.addLayer(L8_Collection_Median,imageVisParam,'Median Images');
