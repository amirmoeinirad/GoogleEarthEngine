// Store the coordinates of a point in a variable
var city = ee.Geometry.Point(49.5039, 37.4304);


// Add the point variable to the map
Map.addLayer(city,0,'Point');
print('Point: ', city);


// Dates of interest
var start = ee.Date('2022-05-01');
var finish = ee.Date('2023-05-01');


// Create image collections
// Landsat 8 Collection 2 Level 1 (Tier 1)
var Anzali = ee.ImageCollection("LANDSAT/LC08/C02/T1_TOA")
.filterBounds(city)
.filterDate(start,finish);


// Get the number of imgages in the collection above
var count = Anzali.size();
print('Size of collection for Anzali:', count);


// Sort the collection by cloud cover
var least_cloudy = ee.Image(Anzali.sort('CLOUD_COVER').first());
var most_cloudy = ee.Image(Anzali.sort('CLOUD_COVER',false).first());


var least_cloudy_percent = least_cloudy.get('CLOUD_COVER');
print('The least cloudy image for Anzali: ', least_cloudy);
print('Cloud Percent: ', least_cloudy_percent);


var most_cloudy_percent = most_cloudy.get('CLOUD_COVER');
print('The most cloudy image for Anzali: ', most_cloudy);
print('Cloud Percent: ', most_cloudy_percent);


// Filter the collection based on cloud cover
var filtered = Anzali.filter(ee.Filter.eq('CLOUD_COVER', 0));
