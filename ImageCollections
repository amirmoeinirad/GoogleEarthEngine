Map.addLayer(Gilan,0,'Gilan Boundary');


// Total number of images in Landsat 8 collection
// 'filterBounds()' filters a collection based on a given geometry.
// 'size()' returns the number of images in a collection.
print('Number of images in the entire Landsat 8 collection for Gilan:');
var Filtered_Region = L8.filterBounds(Gilan);
print(Filtered_Region.size());


// Filtering the collection based on the cloud coverage (in percent)
var Filtered_Region_Cloud = Filtered_Region.filterMetadata('CLOUD_COVER','less_than',40);
print(Filtered_Region_Cloud.size());


// Filtering the collection based on a time range
var Filtered_Region_Cloud_Date = Filtered_Region_Cloud.filterDate('2024-01-01','2024-12-30');
print(Filtered_Region_Cloud_Date.size());


